<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:background="@color/white" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/pad">

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_button" android:gravity="center"
            android:padding="@dimen/pad" android:text="@string/title_main"
            android:textColor="@color/white" android:textSize="@dimen/text_title"
            android:textStyle="bold"/>

        <EditText
            android:textColor="@color/text_dark"
            android:textColorHint="@color/hint_gray"
            android:id="@+id/edtMaKH"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pad" android:background="@drawable/bg_input"
            android:hint="@string/hint_code" android:inputType="textCapCharacters"
            android:maxLength="10"/>

        <EditText
            android:textColor="@color/text_dark"
            android:textColorHint="@color/hint_gray"
            android:id="@+id/edtTenChuHo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap" android:background="@drawable/bg_input"
            android:hint="@string/hint_name" android:inputType="textPersonName|textCapWords"/>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap" android:orientation="horizontal"
            android:weightSum="2">

            <EditText
                android:textColor="@color/text_dark"
                android:textColorHint="@color/hint_gray"
                android:id="@+id/edtChiSoCu"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginEnd="5dp" android:layout_weight="1"
                android:background="@drawable/bg_input" android:hint="@string/hint_old"
                android:inputType="number"/>

            <EditText
                android:textColor="@color/text_dark"
                android:textColorHint="@color/hint_gray"
                android:id="@+id/edtChiSoMoi"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="5dp" android:layout_weight="1"
                android:background="@drawable/bg_input" android:hint="@string/hint_new"
                android:inputType="number"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pad" android:text="@string/label_type"
            android:textColor="@color/text_dark" android:textSize="@dimen/text_body"/>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:background="@drawable/bg_input"
            android:orientation="vertical">
            <Spinner
                android:id="@+id/spnLoaiKH"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pad" android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnXoaTrang"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginEnd="5dp" android:layout_weight="1"
                android:background="@drawable/bg_button" android:text="@string/btn_clear"
                android:textColor="@color/white"/>

            <Button
                android:id="@+id/btnTinhTien"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="5dp" android:layout_weight="1"
                android:background="@drawable/bg_button" android:text="@string/btn_calc"
                android:textColor="@color/white"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnLichSu"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap" android:background="@drawable/bg_button"
            android:text="@string/btn_history" android:textColor="@color/white"/>
    </LinearLayout>
</ScrollView>
